{
  "manifest_version": 3,
  "name": "Etsy Listing Studio - Product Scraper",
  "version": "1.1.0",
  "description": "Scrapes AliExpress product listings and enqueues them directly into Etsy Listing Studio Codex with auto-numbering.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "webRequest",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://generativelanguage.googleapis.com/*",
    "https://*.alicdn.com/*",
    "https://*.aliexpress-media.com/*",
    "https://*.aliexpress.com/*",
    "https://*.aliexpress.us/*",
    "https://*.railway.app/*",
    "https://*.onrender.com/*"
  ]
}
